{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Arteliq",
  "version": "0.1.1",
  "identifier": "ru.arteliq.desktop",
  "build": { "frontendDist": "../ui" },
  "app": {
    "windows": [
      { "label": "main", "title": "Arteliq", "width": 1280, "height": 820, "minWidth": 480, "minHeight": 520 }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": { "../sidecar/dist/arteliq": "sidecar" },
    "category": "DeveloperTool",
    "shortDescription": "Arteliq: команда ИИ-агентов на вашем компьютере",
    "windows": { "nsis": { "installMode": "currentUser", "languages": ["Russian", "English"] } }
  }
}
